<?xml version="1.0" encoding="utf-8"?>
<!-- The encrypted Room DB and key material are intentionally excluded from
     auto-backup; cloud restore happens via Google Sheets/Drive sync instead. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="ledgerly_secure_prefs.xml" />
    <exclude domain="file" path="receipts/" />
</full-backup-content>
