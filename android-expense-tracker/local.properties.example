# Copy to local.properties and adjust. This file is gitignored.
# Path to your Android SDK installation.
sdk.dir=/Users/you/Library/Android/sdk

# Web OAuth 2.0 client ID (from Google Cloud Console) used for Google Sign-In /
# requesting an ID token and incremental auth for Sheets/Drive scopes.
# Exposed to the app via BuildConfig.GOOGLE_WEB_CLIENT_ID.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
