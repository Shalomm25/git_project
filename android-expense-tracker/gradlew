#!/bin/sh
#
# Gradle start up script for POSIX generated by Gradle.
# If the wrapper jar is missing, run `gradle wrapper` once to regenerate it.
#
set -e
APP_HOME=$(cd "$(dirname "$0")" >/dev/null && pwd)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

if [ ! -f "$CLASSPATH" ]; then
    echo "gradle-wrapper.jar not found. Run 'gradle wrapper --gradle-version 8.10.2' once to generate it." >&2
    exit 1
fi

exec "$JAVACMD" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
